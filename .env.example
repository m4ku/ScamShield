# Copy to .env and fill in. Never commit .env.
# AI provider (only "gemini" is built in; see lib/ai/index.ts to add another).
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: override the Gemini model id
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: per-visitor limits (requests per minute) that protect the free AI quota
CHECKS_PER_MINUTE=15
FOLLOWUPS_PER_MINUTE=20
